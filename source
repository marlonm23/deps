-- RASTREADOR DIRETO VIA USERID
trackButton.MouseButton1Click:Connect(function()
    local inputId = searchUserIdBox.Text:gsub("%s+", "")
    local userId = tonumber(inputId)
    
    if not userId then
        searchStatusLabel.Text = "Status: Digite um UserId numérico válido!"
        searchStatusLabel.TextColor3 = Color3.fromRGB(220, 100, 100)
        return
    end

    searchStatusLabel.Text = "Status: Verificando jogador no servidor atual..."
    searchStatusLabel.TextColor3 = Color3.fromRGB(200, 200, 100)

    task.spawn(function()
        local inCurrentServer = Players:GetPlayerByUserId(userId)
        if inCurrentServer then
            searchStatusLabel.Text = "Status: O jogador já está neste servidor!"
            searchStatusLabel.TextColor3 = Color3.fromRGB(50, 220, 50)
            return
        end

        searchStatusLabel.Text = "Status: Consultando Presença via API..."
        
        local reqFunc = (syn and syn.request) or (http and http.request) or request or http_request
        if not reqFunc then
            searchStatusLabel.Text = "Status: Executor sem suporte a http request!"
            searchStatusLabel.TextColor3 = Color3.fromRGB(220, 100, 100)
            return
        end

        local success, response = pcall(function()
            local body = HttpService:JSONEncode({ userIds = { userId } })
            local res = reqFunc({
                Url = "https://presence.roproxy.com/v1/presence/users",
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = body
            })
            return HttpService:JSONDecode(res.Body)
        end)

        if success and response and response.userPresences and response.userPresences[1] then
            local presence = response.userPresences[1]
            local userState = presence.userPresenceType
            local targetJobId = presence.gameId
            local targetPlaceId = presence.placeId

            if userState == 2 and targetJobId and targetJobId ~= "" then
                searchStatusLabel.Text = "Status: Servidor achado! Teleportando..."
                searchStatusLabel.TextColor3 = Color3.fromRGB(50, 220, 50)
                
                saveStateAndTeleport(function()
                    TeleportService:TeleportToPlaceInstance(targetPlaceId or game.PlaceId, targetJobId, LocalPlayer)
                end)
            else
                searchStatusLabel.Text = "Status: Offline, em outro jogo ou privacidade fechada!"
                searchStatusLabel.TextColor3 = Color3.fromRGB(220, 100, 100)
            end
        else
            searchStatusLabel.Text = "Status: Falha na requisição da API."
            searchStatusLabel.TextColor3 = Color3.fromRGB(220, 100, 100)
        end
    end)
end)

