-- AUTO-RESET: Cajado de Vinhas
task.spawn(function()
    while true do
        task.wait(0.2)
        local char = LocalPlayer.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if root and humanoid and humanoid.Health > 0 then
                local pego = false
                for _, child in ipairs(char:GetDescendants()) do
                    if child:IsA("BasePart") then
                        local n = child.Name:lower()
                        if n:find("vinha") or n:find("vine") or n:find("root") or n:find("raiz") or n:find("trap") then
                            pego = true
                            break
                        end
                    elseif child:IsA("WeldConstraint") or child:IsA("Weld") then
                        if child.Part0 and child.Part1 then
                            local other = (child.Part0 == root or child.Part0.Parent == char) and child.Part1 or child.Part0
                            if other and not other:IsDescendantOf(char) and not other:IsDescendantOf(Workspace.Terrain) then
                                pego = true
                                break
                            end
                        end
                    end
                end
                if pgo then
                    humanoid.Health = 0
                end
            end
        end
    end
end)

local function getTargetPlayer()
    local query = targetBox.Text:lower()
    if query == "" then return nil end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local pName, pDisp = player.Name:lower(), player.DisplayName:lower()
            if pName:sub(1, #query) == query or pDisp:sub(1, #query) == query or pName:find(query) or pDisp:find(query) then
                return player
            end
        end
    end
    return nil
end

local function isValidTarget(targetChar)
    if not targetChar then return false end
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    local humanoid = targetChar:FindFirstChildOfClass("Humanoid")
    return targetRoot and humanoid and humanoid.Health > 0
end

-- Varredura ultrarrápida de servidores (Aba 2)
task.spawn(function()
    while true do
        task.wait(1)
        if serverHopSearching then
            local query = searchTargetBox.Text:lower()
            if query ~= "" then
                local found = false
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer then
                        local pName, pDisp = player.Name:lower(), player.DisplayName:lower()
                        if pName:find(query) or pDisp:find(query) then
                            found = true
                            break
                        end
                    end
                end

                if not found then
                    hopStatusButton.Text = "Varrendo..."
                    saveStateAndTeleport(function()
                        pcall(function()
                            local cursor = ""
                            local targetServerId = nil
                            for i = 1, 3 do
                                local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
                                if cursor ~= "" then url = url .. "&cursor=" .. cursor end
                                
                                local req = game:HttpGet(url)
                                local data = HttpService:JSONDecode(req)
                                if data and data.data then
                                    for _, s in ipairs(data.data) do
                                        if type(s) == "table" and s.playing < s.maxPlayers and s.id ~= game.JobId then
                                            if s.players then
                                                for _, p in ipairs(s.players) do
                                                    local n = (p.name or ""):lower()
                                                    local d = (p.displayName or ""):lower()
                                                    if n:find(query) or d:find(query) then
                                                        targetServerId = s.id
                                                        break
                                                    end
                                                end
                                            end
                                        end
                                        if targetServerId then break end
                                    end
                                end
                                if targetServerId or not data.nextPageCursor then break end
                                cursor = data.nextPageCursor
                            end

                            if targetServerId then
                                TeleportService:TeleportToPlaceInstance(game.PlaceId, targetServerId, LocalPlayer)
                            else
                                local req = game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
                                local data = HttpService:JSONDecode(req)
                                if data and data.data then
                                    local servers = {}
                                    for _, s in ipairs(data.data) do
                                        if type(s) == "table" and s.playing < s.maxPlayers and s.id ~= game.JobId then
                                            table.insert(servers, s.id)
                                        end
                                    end
                                    if #servers > 0 then
                                        TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], LocalPlayer)
                                    end
                                end
                            end
                        end)
                    end)
                    task.wait(4)
                end
            end
        end
    end
end)

