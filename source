local function simulateClick(obj)
    pcall(function()
        if obj:IsA("TextButton") or obj:IsA("ImageButton") then
            for _, conn in ipairs(getconnections(obj.MouseButton1Click)) do
                conn:Fire()
            end
            for _, conn in ipairs(getconnections(obj.Activated)) do
                conn:Fire()
            end
            if fireclickdetector and obj:FindFirstChildOfClass("ClickDetector") then
                fireclickdetector(obj:FindFirstChildOfClass("ClickDetector"))
            end
        elseif obj:IsA("ProximityPrompt") then
            fireproximityprompt(obj)
        elseif obj:IsA("BasePart") then
            local cd = obj:FindFirstChildOfClass("ClickDetector")
            if cd and fireclickdetector then
                fireclickdetector(cd)
            end
        end
    end)
end

local function scanAndPressStartButtons()
    local keywords = {"iniciar", "start", "play", "começar", "jogar", "ready", "spawn", "entrar"}
    local foundCount = 0
    local logText = "🔍 Varrendo botões...\n"

    for _, gui in ipairs(PlayerGui:GetDescendants()) do
        if gui:IsA("TextButton") or gui:IsA("ImageButton") then
            local textToCheck = ""
            if gui:IsA("TextButton") then
                textToCheck = (gui.Text .. " " .. gui.Name):lower()
            else
                textToCheck = gui.Name:lower()
            end

            for _, kw in ipairs(keywords) do
                if textToCheck:find(kw) and gui.Visible then
                    foundCount = foundCount + 1
                    logText = logText .. " • Clicando GUI: " .. gui.Name .. "\n"
                    simulateClick(gui)
                    task.wait(0.2)
                    break
                end
            end
        end
    end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") or obj:IsA("ClickDetector") or obj:IsA("BasePart") then
            local nameToCheck = obj.Name:lower()
            for _, kw in ipairs(keywords) do
                if nameToCheck:find(kw) then
                    foundCount = foundCount + 1
                    logText = logText .. " • Acionando 3D: " .. obj.Name .. "\n"
                    simulateClick(obj)
                    task.wait(0.2)
                    break
                end
            end
        end
    end

    if foundCount == 0 then
        statusAutoLabel.Text = logText .. "\n❌ Nenhum botão encontrado."
    else
        statusAutoLabel.Text = logText .. "\n✨ Sucesso! " .. foundCount .. " acionados."
    end
end

