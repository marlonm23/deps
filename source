-- PROTEÇÃO TOTAL (Anti-Fling + Anti-Void + Imunidade a Dano/Queda)
RunService.Stepped:Connect(function()
    if not antiFlingActive then return end
    
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        pcall(function()
            humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            if humanoid.Health < humanoid.MaxHealth and humanoid.Health > 0 then
                humanoid.Health = humanoid.MaxHealth
            end
        end)
    end

    if root then
        if root.Position.Y > -30 and root.AssemblyLinearVelocity.Magnitude < 120 then
            lastSafeCFrame = root.CFrame
        end

        if root.Position.Y < -50 and lastSafeCFrame then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = lastSafeCFrame + Vector3.new(0, 5, 0)
        end

        if not flingActive and not guardActive and (root.AssemblyLinearVelocity.Magnitude > 180 or root.AssemblyAngularVelocity.Magnitude > 180) then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local otherRoot = player.Character:FindFirstChild("HumanoidRootPart")
            if otherRoot and (otherRoot.AssemblyLinearVelocity.Magnitude > 250 or otherRoot.AssemblyAngularVelocity.Magnitude > 250) then
                pcall(function()
                    otherRoot.AssemblyLinearVelocity = Vector3.zero
                    otherRoot.AssemblyAngularVelocity = Vector3.zero
                end)
            end
        end
    end
end)

-- NÚCLEO DE BLOCOS CENTRALIZADO NO PEITO DO PERSONAGEM
local activeOrbitParts = {}

local function clearOrbitParts()
    for _, data in ipairs(activeOrbitParts) do
        if data.constraints then
            for _, nc in ipairs(data.constraints) do
                pcall(function() nc:Destroy() end)
            end
        end
    end
    table.clear(activeOrbitParts)
end

RunService.Heartbeat:Connect(function()
    if not throwPartsActive then
        if #activeOrbitParts > 0 then
            clearOrbitParts()
        end
        return
    end

    local myChar = LocalPlayer.Character
    local chestPart = myChar and (myChar:FindFirstChild("UpperTorso") or myChar:FindFirstChild("Torso") or myChar:FindFirstChild("HumanoidRootPart"))
    if not chestPart then return end

    -- Captura blocos soltos num raio de 400 studs
    for _, part in ipairs(Workspace:GetDescendants()) do
        if part:IsA("BasePart") and not part.Anchored and not part.Locked then
            local isCharPart = false
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character and part:IsDescendantOf(p.Character) then
                    isCharPart = true
                    break
                end
            end

            if not isCharPart and (part.Position - chestPart.Position).Magnitude < 400 then
                local alreadyTracked = false
                for _, item in ipairs(activeOrbitParts) do
                    if item.part == part then
                        alreadyTracked = true
                        break
                    end
                end

                if not alreadyTracked and #activeOrbitParts < 80 then
                    -- Bloqueia colisão do bloco com TODAS as partes do seu próprio boneco
                    local constraints = {}
                    for _, myPart in ipairs(myChar:GetDescendants()) do
                        if myPart:IsA("BasePart") then
                            local nc = Instance.new("NoCollisionConstraint")
                            nc.Part0 = part
                            nc.Part1 = myPart
                            nc.Parent = part
                            table.insert(constraints, nc)
                        end
                    end

                    table.insert(activeOrbitParts, {
                        part = part,
                        constraints = constraints
                    })
                end
            end
        end
    end

    -- Centraliza TODOS os blocos exatamente no centro do seu peito girando no próprio eixo
    local chestPos = chestPart.Position
    for i = #activeOrbitParts, 1, -1 do
        local data = activeOrbitParts[i]
        local part = data.part

        if not part or not part.Parent or part.Anchored then
            if data.constraints then
                for _, nc in ipairs(data.constraints) do
                    pcall(function() nc:Destroy() end)
                end
            end
            table.remove(activeOrbitParts, i)
        else
            pcall(function()
                part.CanCollide = true
                part.CustomPhysicalProperties = PhysicalProperties.new(100, 2, 2, 2, 2)

                -- Puxa direto para o centro do peito (raio zero)
                local toChest = (chestPos - part.Position)
                part.AssemblyLinearVelocity = toChest * 85
                part.AssemblyAngularVelocity = Vector3.new(99999, 99999, 99999)
            end)
        end
    end
end)

-- PERSEGUIÇÃO DO TORNADO DE PEITO (Prioriza o mais perto e fica 1.5s na pessoa)
task.spawn(function()
    while true do
        if not throwPartsActive or flingActive or guardActive then
            task.wait(0.15)
            continue
        end

        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myRoot then
            task.wait(0.3)
            continue
        end

        if todosActive then
            local validTargets = {}
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and isValidTarget(p.Character) then
                    local targetRoot = p.Character:FindFirstChild("HumanoidRootPart")
                    if targetRoot then
                        local dist = (myRoot.Position - targetRoot.Position).Magnitude
                        table.insert(validTargets, {char = p.Character, root = targetRoot, dist = dist})
                    end
                end
            end

            table.sort(validTargets, function(a, b)
                return a.dist < b.dist
            end)

            if #validTargets > 0 then
                for _, targetData in ipairs(validTargets) do
                    if not throwPartsActive or not todosActive or flingActive or guardActive then break end
                    local targetChar = targetData.char
                    local targetRoot = targetData.root
                    
                    if targetRoot and isValidTarget(targetChar) then
                        local startTick = tick()
                        while throwPartsActive and todosActive and not flingActive and not guardActive and isValidTarget(targetChar) and (tick() - startTick < 1.5) do
                            myChar = LocalPlayer.Character
                            myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                            if not myRoot then break end
                            myRoot.CFrame = targetRoot.CFrame
                            RunService.Heartbeat:Wait()
                        end
                    end
                end
            else
                task.wait(0.3)
            end
        else
            local targetPlayer = getTargetPlayer()
            if targetPlayer and targetPlayer.Character and isValidTarget(targetPlayer.Character) then
                local targetChar = targetPlayer.Character
                local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
                if targetRoot then
                    while throwPartsActive and not todosActive and not flingActive and not guardActive and targetPlayer.Character == targetChar and isValidTarget(targetChar) do
                        myChar = LocalPlayer.Character
                        myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                        if not myRoot then break end
                        myRoot.CFrame = targetRoot.CFrame
                        RunService.Heartbeat:Wait()
                    end
                end
            else
                task.wait(0.2)
            end
        end
    end
end)

-- Loop Fling Dinâmico (Prioriza o mais perto e fica 1.2s na pessoa)
task.spawn(function()
    while true do
        if not flingActive or guardActive then
            task.wait(0.2)
            continue
        end

        local character = LocalPlayer.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        
        if not rootPart or not humanoid or humanoid.Health <= 0 then
            task.wait(0.5)
            continue
        end

        local function applyFlingForce(targetRoot)
            pcall(function()
                targetRoot.CanCollide = true
                targetRoot.CustomPhysicalProperties = PhysicalProperties.new(100, 0, 0, 0, 0)
                for _, part in ipairs(targetRoot.Parent:GetChildren()) do
                    if part:IsA("BasePart") then part.CanCollide = true end
                end
            end)

            if scriptFightActive then
                rootPart.CFrame = targetRoot.CFrame + Vector3.new(0, 1, 0)
                rootPart.AssemblyLinearVelocity = Vector3.new(math.random(-99999, 99999), 85000, math.random(-99999, 99999))
                rootPart.AssemblyAngularVelocity = Vector3.new(99999, 99999, 99999)
            else
                local randomOffset = CFrame.new(
                    math.random(-100, 100) / 100, 
                    math.random(-50, 50) / 100, 
                    math.random(-100, 100) / 100
                )
                rootPart.CFrame = targetRoot.CFrame * randomOffset
                rootPart.AssemblyLinearVelocity = Vector3.new(math.random(-30000, 30000), math.random(30000, 50000), math.random(-30000, 30000))
                rootPart.AssemblyAngularVelocity = Vector3.new(999999, 999999, 999999)
            end
        end

        if todosActive then
            local validTargets = {}
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character and isValidTarget(player.Character) then
                    local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
                    if targetRoot then
                        local dist = (rootPart.Position - targetRoot.Position).Magnitude
                        table.insert(validTargets, {char = player.Character, root = targetRoot, dist = dist})
                    end
                end
            end

            table.sort(validTargets, function(a, b)
                return a.dist < b.dist
            end)

            if #validTargets > 0 then
                for _, targetData in ipairs(validTargets) do
                    if not flingActive or not todosActive or guardActive then break end
                    local targetChar = targetData.char
                    local targetRoot = targetData.root
                    
                    if targetRoot and isValidTarget(targetChar) then
                        local startTick = tick()
                        local duration = 1.2
                        while flingActive and todosActive and not guardActive and isValidTarget(targetChar) and (tick() - startTick < duration) do
                            character = LocalPlayer.Character
                            rootPart = character and character:FindFirstChild("HumanoidRootPart")
                            if not character or not rootPart then break end

                            applyFlingForce(targetRoot)
                            RunService.Heartbeat:Wait()
                        end
                    end
                end
            else
                task.wait(0.3)
            end
        else
            local targetPlayer = getTargetPlayer()
            if targetPlayer and targetPlayer.Character and isValidTarget(targetPlayer.Character) then
                local targetChar = targetPlayer.Character
                local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
                
                if targetRoot then
                    while flingActive and not todosActive and not guardActive and targetPlayer.Character == targetChar and isValidTarget(targetChar) do
                        character = LocalPlayer.Character
                        rootPart = character and character:FindFirstChild("HumanoidRootPart")
                        if not character or not rootPart then break end
                        
                        applyFlingForce(targetRoot)
                        RunService.Heartbeat:Wait()
                    end
                end
            else
                task.wait(0.3)
            end
        end
    end
end)