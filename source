-- ==========================================
-- FUNÇÕES DE ALVO
-- ==========================================
local function getTargetPlayer()
    local query = targetBox.Text:lower()
    if query == "" then return nil end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local pName = player.Name:lower()
            local pDisp = player.DisplayName:lower()
            if pName:sub(1, #query) == query or pDisp:sub(1, #query) == query or pName:find(query) or pDisp:find(query) then
                return player
            end
        end
    end
    return nil
end

local function isValidTarget(targetChar)
    if not targetChar then return false end
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    local humanoid = targetChar:FindFirstChildOfClass("Humanoid")
    if not targetRoot or not humanoid or humanoid.Health <= 0 then 
        return false 
    end
    return true
end

-- ==========================================
-- LOOP: ANTI-FLING
-- ==========================================
RunService.Stepped:Connect(function()
    if not antiFlingActive then return end
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if root then
        if root.AssemblyLinearVelocity.Magnitude > 300 or root.AssemblyAngularVelocity.Magnitude > 300 then
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
    end
end)

-- ==========================================
-- LOOP: JOGAR BLOCOS NOS JOGADORES (ITENS DA LAVA)
-- ==========================================
task.spawn(function()
    while true do
        if not throwPartsActive then
            task.wait(0.2)
            continue
        end

        local targetChar = nil
        if todosActive then
            local validPlayers = {}
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and isValidTarget(p.Character) then
                    table.insert(validPlayers, p.Character)
                end
            end
            if #validPlayers > 0 then
                targetChar = validPlayers[math.random(1, #validPlayers)]
            end
        else
            local targetPlayer = getTargetPlayer()
            if targetPlayer and targetPlayer.Character and isValidTarget(targetPlayer.Character) then
                targetChar = targetPlayer.Character
            end
        end

        if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
            local targetRoot = targetChar.HumanoidRootPart
            
            -- Varre o workspace procurando blocos livres/soltos (como os blocos cinzas da lava)
            for _, part in ipairs(Workspace:GetDescendants()) do
                if not throwPartsActive then break end
                if part:IsA("BasePart") and not part.Anchored then
                    -- Evita mexer no personagem do próprio jogador ou de outros players
                    local isCharacterPart = false
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p.Character and part:IsDescendantOf(p.Character) then
                            isCharacterPart = true
                            break
                        end
                    end

                    if not isCharacterPart then
                        pcall(function()
                            part.CanCollide = false
                            -- Teleporta o bloco para perto da cabeça/corpo do alvo e dá uma velocidade explosiva em direção a ele
                            part.CFrame = targetRoot.CFrame + Vector3.new(math.random(-2, 2), math.random(0, 4), math.random(-2, 2))
                            part.AssemblyLinearVelocity = Vector3.new(math.random(-400, 400), 600, math.random(-400, 400))
                        end)
                    end
                end
            end
        end
        task.wait(0.15)
    end
end)

-- ==========================================
-- LOOP: FLING (MODO TODOS OU ALVO ÚNICO)
-- ==========================================
task.spawn(function()
    while true do
        if not flingActive then
            task.wait(0.2)
            continue
        end

        local character = LocalPlayer.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        
        if not rootPart or not humanoid or humanoid.Health <= 0 then
            task.wait(0.5)
            continue
        end

        if todosActive then
            local targets = {}
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character and isValidTarget(player.Character) then
                    table.insert(targets, player.Character)
                end
            end

            if #targets > 0 then
                for _, targetChar in ipairs(targets) do
                    if not flingActive or not todosActive then break end
                    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
                    if targetRoot and isValidTarget(targetChar) then
                        local startTick = tick()
                        while flingActive and todosActive and isValidTarget(targetChar) and (tick() - startTick < 0.15) do
                            character = LocalPlayer.Character
                            rootPart = character and character:FindFirstChild("HumanoidRootPart")
                            if not character or not rootPart then break end

                            pcall(function()
                                targetRoot.CanCollide = true
                                for _, part in ipairs(targetChar:GetChildren()) do
                                    if part:IsA("BasePart") then part.CanCollide = true end
                                end
                            end)

                            local randomOffset = CFrame.new(
                                math.random(-150, 150) / 100, 
                                math.random(-50, 100) / 100, 
                                math.random(-150, 150) / 100
                            )
                            rootPart.CFrame = targetRoot.CFrame * randomOffset
                            rootPart.AssemblyLinearVelocity = Vector3.new(50000, 50000, 50000)
                            rootPart.AssemblyAngularVelocity = Vector3.new(50000, 50000, 50000)

                            RunService.Heartbeat:Wait()
                        end
                    end
                end
            else
                task.wait(0.5)
            end
        else
            local targetPlayer = getTargetPlayer()
            if targetPlayer and targetPlayer.Character and isValidTarget(targetPlayer.Character) then
                local targetChar = targetPlayer.Character
                local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
                
                if targetRoot then
                    while flingActive and not todosActive and targetPlayer.Character == targetChar and isValidTarget(targetChar) do
                        character = LocalPlayer.Character
                        rootPart = character and character:FindFirstChild("HumanoidRootPart")
                        
                        if not character or not rootPart then break end
                        
                        pcall(function()
                            targetRoot.CanCollide = true
                            for _, part in ipairs(targetChar:GetChildren()) do
                                if part:IsA("BasePart") then
                                    part.CanCollide = true
                                end
                            end
                        end)
                        
                        local randomOffset = CFrame.new(
                            math.random(-150, 150) / 100, 
                            math.random(-50, 100) / 100, 
                            math.random(-150, 150) / 100
                        )
                        rootPart.CFrame = targetRoot.CFrame * randomOffset
                        rootPart.AssemblyLinearVelocity = Vector3.new(50000, 50000, 50000)
                        rootPart.AssemblyAngularVelocity = Vector3.new(50000, 50000, 50000)
                        
                        RunService.Heartbeat:Wait()
                    end
                end
            else
                task.wait(0.5)
            end
        end
    end
end)