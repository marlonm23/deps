-- Sistema de Flight (Voo) Suave
local userInputStates = {W = false, A = false, S = false, D = false, Space = false, LeftShift = false}

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.W then userInputStates.W = true end
    if input.KeyCode == Enum.KeyCode.A then userInputStates.A = true end
    if input.KeyCode == Enum.KeyCode.S then userInputStates.S = true end
    if input.KeyCode == Enum.KeyCode.D then userInputStates.D = true end
    if input.KeyCode == Enum.KeyCode.Space then userInputStates.Space = true end
    if input.KeyCode == Enum.KeyCode.LeftShift then userInputStates.LeftShift = true end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.W then userInputStates.W = false end
    if input.KeyCode == Enum.KeyCode.A then userInputStates.A = false end
    if input.KeyCode == Enum.KeyCode.S then userInputStates.S = false end
    if input.KeyCode == Enum.KeyCode.D then userInputStates.D = false end
    if input.KeyCode == Enum.KeyCode.Space then userInputStates.Space = false end
    if input.KeyCode == Enum.KeyCode.LeftShift then userInputStates.LeftShift = false end
end)

RunService.RenderStepped:Connect(function(dt)
    if not flightActive then return end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    hum.PlatformStand = true
    local camCFrame = Camera.CFrame
    local moveDir = Vector3.zero

    if userInputStates.W then moveDir = moveDir + camCFrame.LookVector end
    if userInputStates.S then moveDir = moveDir - camCFrame.LookVector end
    if userInputStates.A then moveDir = moveDir - camCFrame.RightVector end
    if userInputStates.D then moveDir = moveDir + camCFrame.RightVector end
    if userInputStates.Space then moveDir = moveDir + Vector3.new(0, 1, 0) end
    if userInputStates.LeftShift then moveDir = moveDir - Vector3.new(0, 1, 0) end

    local currentSpeed = flightSpeed
    if userInputStates.LeftShift and userInputStates.Space == false then
        currentSpeed = flightSpeed * 2
    end

    if moveDir.Magnitude > 0 then
        moveDir = moveDir.Unit * currentSpeed
    end

    root.AssemblyLinearVelocity = moveDir
    root.AssemblyAngularVelocity = Vector3.zero
    root.CFrame = CFrame.new(root.Position, root.Position + camCFrame.LookVector)
end)

RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not flightActive and hum and hum.PlatformStand then
        hum.PlatformStand = false
    end
end)

-- Proteção Total (Anti-Fling, Anti-Void)
RunService.Stepped:Connect(function()
    if not antiFlingActive then return end
    
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        pcall(function()
            humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            if not flightActive then
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
                if humanoid.Sit then humanoid.Sit = false end
            end
            if humanoid.Health < humanoid.MaxHealth and humanoid.Health > 0 then
                humanoid.Health = humanoid.MaxHealth
            end
        end)
    end

    if root then
        if root.Position.Y > -30 and root.AssemblyLinearVelocity.Magnitude < 120 then
            lastSafeCFrame = root.CFrame
        end

        if root.Position.Y < -50 and lastSafeCFrame and not flightActive then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = lastSafeCFrame + Vector3.new(0, 5, 0)
        end

        if not flingActive and not flightActive and (root.AssemblyLinearVelocity.Magnitude > 180 or root.AssemblyAngularVelocity.Magnitude > 180) then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end
end)

-- ==============================================================
-- LOOP DE FLING NORMAL (JOGA O PLAYER PARA O FUNDO DO MAPA)
-- ==============================================================
task.spawn(function()
    while true do
        if not flingActive then
            task.wait(0.15)
            continue
        end

        local character = LocalPlayer.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        
        if not rootPart or not humanoid or humanoid.Health <= 0 then
            task.wait(0.3)
            continue
        end

        local function applyDownwardFling(targetRoot)
            pcall(function()
                humanoid:ChangeState(Enum.HumanoidStateType.Physics)
                
                for _, myPart in ipairs(character:GetChildren()) do
                    if myPart:IsA("BasePart") then
                        myPart.CanCollide = true
                        myPart.Massless = false
                    end
                end
                rootPart.CustomPhysicalProperties = PhysicalProperties.new(100, 1, 0, 1, 0)

                targetRoot.CanCollide = true
                for _, part in ipairs(targetRoot.Parent:GetChildren()) do
                    if part:IsA("BasePart") then part.CanCollide = true end
                end
            end)

            local offset = CFrame.new(
                math.random(-60, 60) / 100, 
                1.0, 
                math.random(-60, 60) / 100
            ) * CFrame.Angles(math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)), math.rad(math.random(-180, 180)))

            rootPart.CFrame = targetRoot.CFrame * offset
            -- Joga com força máxima para baixo (Void)
            rootPart.AssemblyLinearVelocity = Vector3.new(
                math.random(-15000, 15000), 
                math.random(-85000, -65000), 
                math.random(-15000, 15000)
            )
            rootPart.AssemblyAngularVelocity = Vector3.new(999999, 999999, 999999)
        end

        if todosActive then
            local validTargets = {}
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character and isValidTarget(player.Character) then
                    local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
                    if targetRoot then
                        local dist = (rootPart.Position - targetRoot.Position).Magnitude
                        table.insert(validTargets, {char = player.Character, root = targetRoot, dist = dist})
                    end
                end
            end

            table.sort(validTargets, function(a, b)
                return a.dist < b.dist
            end)

            if #validTargets > 0 then
                for _, targetData in ipairs(validTargets) do
                    if not flingActive or not todosActive then break end
                    local targetChar = targetData.char
                    local targetRoot = targetData.root
                    
                    if targetRoot and isValidTarget(targetChar) then
                        local startTick = tick()
                        local duration = 1.0
                        while flingActive and todosActive and isValidTarget(targetChar) and (tick() - startTick < duration) do
                            character = LocalPlayer.Character
                            rootPart = character and character:FindFirstChild("HumanoidRootPart")
                            humanoid = character and character:FindFirstChildOfClass("Humanoid")
                            if not character or not rootPart or not humanoid then break end

                            applyDownwardFling(targetRoot)
                            RunService.Heartbeat:Wait()
                        end
                    end
                end
            else
                task.wait(0.2)
            end
        else
            local targetPlayer = getTargetPlayer()
            if targetPlayer and targetPlayer.Character and isValidTarget(targetPlayer.Character) then
                local targetChar = targetPlayer.Character
                local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
                
                if targetRoot then
                    while flingActive and not todosActive and targetPlayer.Character == targetChar and isValidTarget(targetChar) do
                        character = LocalPlayer.Character
                        rootPart = character and character:FindFirstChild("HumanoidRootPart")
                        humanoid = character and character:FindFirstChildOfClass("Humanoid")
                        if not character or not rootPart or not humanoid then break end
                        
                        applyDownwardFling(targetRoot)
                        RunService.Heartbeat:Wait()
                    end
                end
            else
                task.wait(0.2)
            end
        end
    end
