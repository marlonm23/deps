-- Detecção de Teleporte do Jogo (salva a posição anterior se o jogo mover o jogador)
local lastPos = nil
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if root then
        if lastPos then
            local dist = (root.Position - lastPos).Magnitude
            if dist > 45 then
                savedPos = CFrame.new(lastPos)
                statusLabel.Text = "Status: Teleporte detectado! 'Fim' atualizado para a posição anterior."
            end
        end
        lastPos = root.Position
    end
end)


