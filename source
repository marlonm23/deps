local function saveStateAndTeleport(teleportFunction)
    if queueteleport then
        local targetVal = targetBox and targetBox.Text or savedConfig.targetText
        local searchVal = searchTargetBox and searchTargetBox.Text or savedConfig.searchTargetText
        
        local codeToQueue = string.format([[
            _G.MassFlingConfig = {
                flingActive = %s,
                todosActive = %s,
                antiFlingActive = %s,
                invisibleActive = %s,
                throwPartsActive = %s,
                targetText = %q,
                searchTargetText = %q,
                serverHopSearching = %s
            }
            loadstring(game:HttpGet(%q))()
        ]], 
        tostring(flingActive), tostring(todosActive), tostring(antiFlingActive), 
        tostring(invisibleActive), tostring(throwPartsActive), targetVal, 
        searchVal, tostring(serverHopSearching), scriptUrl)

        pcall(function()
            queueteleport(codeToQueue)
        end)
    end
    teleportFunction()
end

