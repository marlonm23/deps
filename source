            _G.MassFlingConfig = {
                flingActive = %s,
                scriptFightActive = %s,
                todosActive = %s,
                antiFlingActive = %s,
                invisibleActive = %s,
                throwPartsActive = %s,
                guardActive = %s,
                targetText = %q
            }
            loadstring(game:HttpGet(%q))()
        ]], 
        tostring(flingActive), tostring(scriptFightActive), tostring(todosActive), tostring(antiFlingActive), 
        tostring(invisibleActive), tostring(throwPartsActive), tostring(guardActive), targetVal, scriptUrl)

        pcall(function()
            queueteleport(codeToQueue)
        end)
    end
    teleportFunction()
end

