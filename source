local function getTargetPlayer()
    local query = targetBox.Text:lower()
    if query == "" then return nil end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local pName, pDisp = player.Name:lower(), player.DisplayName:lower()
            if pName:sub(1, #query) == query or pDisp:sub(1, #query) == query or pName:find(query) or pDisp:find(query) then
                return player
            end
        end
    end
    return nil
end

local function isValidTarget(targetChar)
    if not targetChar then return false end
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    return targetRoot ~= nil
end

-- SISTEMA DE PROTEÇÃO NO STEPPED (Roda antes do motor de física para neutralizar o fling do alvo nos outros)
local lastGuardedChar = nil
RunService.Stepped:Connect(function()
    if not guardActive then
        if #guardConstraints > 0 then
            clearGuardConstraints()
            lastGuardedChar = nil
        end
        return
    end

    local targetPlayer = getTargetPlayer()
    if targetPlayer and targetPlayer.Character and isValidTarget(targetPlayer.Character) then
        local targetChar = targetPlayer.Character
        local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
        
        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

        if targetRoot and myRoot then
            -- Se mudou o personagem protegido, recria as travas de colisão
            if lastGuardedChar ~= targetChar then
                clearGuardConstraints()
                lastGuardedChar = targetChar
            end

            pcall(function()
                -- 1. Desativa colisão física de TODAS as partes do alvo (script) e zera massa/atrito dele
                for _, part in ipairs(targetChar:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                        part.CustomPhysicalProperties = PhysicalProperties.new(0.01, 0, 0, 0, 0)
                        part.AssemblyLinearVelocity = Vector3.zero
                        part.AssemblyAngularVelocity = Vector3.zero
                    end
                end

                -- 2. Cria NoCollisionConstraint entre o script e TODOS os outros jogadores (exceto você)
                if #guardConstraints == 0 then
                    for _, otherPlayer in ipairs(Players:GetPlayers()) do
                        if otherPlayer ~= LocalPlayer and otherPlayer ~= targetPlayer and otherPlayer.Character then
                            for _, tPart in ipairs(targetChar:GetDescendants()) do
                                if tPart:IsA("BasePart") then
                                    for _, oPart in ipairs(otherPlayer.Character:GetDescendants()) do
                                        if oPart:IsA("BasePart") then
                                            local nc = Instance.new("NoCollisionConstraint")
                                            nc.Part0 = tPart
                                            nc.Part1 = oPart
                                            nc.Parent = tPart
                                            table.insert(guardConstraints, nc)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end

                -- 3. Cola você no alvo para absorver o impacto no lugar dos outros
                myRoot.CFrame = targetRoot.CFrame
                myRoot.CanCollide = true
                myRoot.CustomPhysicalProperties = PhysicalProperties.new(100, 0, 0, 0, 0)
            end)
        end
    else
        if #guardConstraints > 0 then
            clearGuardConstraints()
            lastGuardedChar = nil
        end
    end
end)

