local vsTick = 0
local vsThrust = nil
local vsSpin = nil
local wasVsActive = false

local function cleanVsForces()
    if vsThrust then pcall(function() vsThrust:Destroy() end) vsThrust = nil end
    if vsSpin then pcall(function() vsSpin:Destroy() end) vsSpin = nil end
end

-- Força colisão e Anti-Sit no Stepped (onde o Humanoid tenta desligar)
RunService.Stepped:Connect(function()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

    if not vsScriptActive or guardActive then
        cleanVsForces()
        if wasVsActive and myHum then
            wasVsActive = false
            pcall(function()
                myHum.PlatformStand = false
                myHum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end)
        end
        return
    end

    wasVsActive = true
    if myChar and myRoot and myHum then
        pcall(function()
            myHum.PlatformStand = true
            myHum.Sit = false
            myHum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
            for _, part in ipairs(myChar:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = true
                    part.Massless = false
                end
            end
        end)
    end
end)

local function executeVsScriptAttack()
    if not vsScriptActive or guardActive then 
        cleanVsForces()
        return 
    end

    local targetPlayer = findPlayerByQuery(vsTargetBox.Text)
    if not targetPlayer or not targetPlayer.Character or not isValidTarget(targetPlayer.Character) then 
        cleanVsForces()
        return 
    end

    local targetChar = targetPlayer.Character
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

    if not targetRoot or not myRoot or not myHum or myHum.Health <= 0 or (targetHum and targetHum.Health <= 0) then 
        cleanVsForces()
        return 
    end

    vsTick = vsTick + 1

    pcall(function()
        -- 1. Cria forças físicas persistentes no RootPart para o servidor replicar o impacto
        if not vsThrust or vsThrust.Parent ~= myRoot then
            cleanVsForces()
            vsThrust = Instance.new("BodyThrust")
            vsThrust.Name = "VsFlingThrust"
            vsThrust.Force = Vector3.new(999999, 999999, 999999)
            vsThrust.Location = Vector3.new(0, 0, 0)
            vsThrust.Parent = myRoot

            vsSpin = Instance.new("BodyAngularVelocity")
            vsSpin.Name = "VsFlingSpin"
            vsSpin.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            vsSpin.AngularVelocity = Vector3.new(999999, 999999, 999999)
            vsSpin.P = math.huge
            vsSpin.Parent = myRoot
        end

        myRoot.CustomPhysicalProperties = PhysicalProperties.new(100, 1, 1, 1, 1)

        -- 2. Previsão de movimento do script inimigo
        local targetVel = targetRoot.AssemblyLinearVelocity
        if targetVel.Magnitude > 500 then
            targetVel = Vector3.zero
        end
        local predictedPos = targetRoot.Position + (targetVel * 0.05)

        -- 3. Alterna entre interseção direta (centro) e varredura lateral/diagonal
        local phase = vsTick % 4
        local offset = Vector3.zero
        local attackVel = Vector3.zero

        if phase == 0 then
            offset = Vector3.new(0, 0, 0)
            attackVel = Vector3.new(65000, 65000, -65000)
        elseif phase == 1 then
            offset = Vector3.new(0.8, -0.5, 0.8)
            attackVel = Vector3.new(-65000, 85000, 65000)
        elseif phase == 2 then
            offset = Vector3.new(-0.8, 0.5, -0.8)
            attackVel = Vector3.new(65000, -45000, 65000)
        else
            offset = Vector3.new(0, 0.2, 0)
            attackVel = Vector3.new(-65000, 75000, -65000)
        end

        -- 4. Aplica CFrame com rotação caótica para enganchar nas partes R6/R15 do alvo
        myRoot.CFrame = CFrame.new(predictedPos + offset) * CFrame.Angles(
            math.rad((vsTick * 113) % 360),
            math.rad((vsTick * 157) % 360),
            math.rad((vsTick * 199) % 360)
        )

        myRoot.AssemblyLinearVelocity = attackVel
        myRoot.AssemblyAngularVelocity = Vector3.new(999999, 999999, 999999)
        
        if vsThrust then
            vsThrust.Location = targetRoot.Position
        end
    end)
end

