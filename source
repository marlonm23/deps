-- DETECTOR DE EFEITO VERDE / CAJADO DE VINHAS
task.spawn(function()
    while true do
        task.wait(0.15)
        local char = LocalPlayer.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if root and humanoid and humanoid.Health > 0 then
                local pegoPelasVinhas = false

                for _, obj in ipairs(char:GetChildren()) do
                    if obj:IsA("Highlight") or obj:IsA("SelectionBox") then
                        local c = obj.FillColor or obj.OutlineColor or obj.Color3
                        if c and (c.G > 0.6 and c.R < 0.4) then
                            pegoPelasVinhas = true
                            break
                        end
                    elseif obj:IsA("Model") or obj:IsA("Folder") then
                        local n = obj.Name:lower()
                        if n:find("vinha") or n:find("vine") or n:find("root") or n:find("raiz") or n:find("trap") then
                            pegoPelasVinhas = true
                            break
                        end
                    end
                end

                if not pegoPelasVinhas and humanoid.WalkSpeed == 0 then
                    for _, child in ipairs(Workspace:GetDescendants()) do
                        if child:IsA("BasePart") and not child:IsDescendantOf(char) and not child:IsDescendantOf(Workspace.Terrain) then
                            local n = child.Name:lower()
                            if (n:find("vinha") or n:find("vine") or n:find("root") or n:find("raiz")) and (child.Position - root.Position).Magnitude < 6 then
                                pegoPelasVinhas = true
                                break
                            end
                        end
                    end
                end

                if pegoPelasVinhas then
                    humanoid.Health = 0
                end
            end
        end
    end
end)

local function getTargetPlayer()
    local query = targetBox.Text:lower()
    if query == "" then return nil end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local pName, pDisp = player.Name:lower(), player.DisplayName:lower()
            if pName:sub(1, #query) == query or pDisp:sub(1, #query) == query or pName:find(query) or pDisp:find(query) then
                return player
            end
        end
    end
    return nil
end

local function isValidTarget(targetChar)
    if not targetChar then return false end
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    local humanoid = targetChar:FindFirstChildOfClass("Humanoid")
    return targetRoot and humanoid and humanoid.Health > 0
end

