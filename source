local function saveStateAndTeleport(teleportFunction)
    if queueteleport then
        local targetVal = targetBox and targetBox.Text or savedConfig.targetText
        local vsTargetVal = vsTargetBox and vsTargetBox.Text or savedConfig.vsScriptTarget
        
        local codeToQueue = string.format([[
            _G.MassFlingConfig = {
                flingActive = %s,
                todosActive = %s,
                antiFlingActive = %s,
                invisibleActive = %s,
                throwPartsActive = %s,
                guardActive = %s,
                autoStartActive = %s,
                vsScriptActive = %s,
                vsScriptTarget = %q,
                targetText = %q
            }
            loadstring(game:HttpGet(%q))()
        ]], 
        tostring(flingActive), tostring(todosActive), tostring(antiFlingActive), 
        tostring(invisibleActive), tostring(throwPartsActive), tostring(guardActive), 
        tostring(autoStartActive), tostring(vsScriptActive), vsTargetVal, targetVal, scriptUrl)

        pcall(function()
            queueteleport(codeToQueue)
        end)
    end
    teleportFunction()
end

