-- Tabela global para armazenar as cores que aparecem na aba 2
local loggedColors = {}

-- Rastreador de Cores de Blocos (Aba 2)
task.spawn(function()
    while true do
        task.wait(1)
        pcall(function()
            for _, part in ipairs(Workspace:GetDescendants()) do
                if part:IsA("BasePart") and not part.Anchored then
                    local isChar = false
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p.Character and part:IsDescendantOf(p.Character) then
                            isChar = true
                            break
                        end
                    end

                    if not isChar then
                        local bColor = tostring(part.BrickColor)
                        local color3 = part.Color
                        local colorKey = bColor .. string.format(" (R:%d G:%d B:%d)", math.floor(color3.R*255), math.floor(color3.G*255), math.floor(color3.B*255))
                        
                        if not loggedColors[colorKey] then
                            loggedColors[colorKey] = true
                            
                            local colorLabel = Instance.new("TextLabel")
                            colorLabel.Size = UDim2.new(1, -10, 0, 22)
                            colorLabel.BackgroundTransparency = 1
                            colorLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
                            colorLabel.TextSize = 11
                            colorLabel.Font = Enum.Font.Code
                            colorLabel.TextXAlignment = Enum.TextXAlignment.Left
                            colorLabel.Text = colorKey
                            colorLabel.Parent = colorsScroll
                        end
                    end
                end
            end
        end)
    end
end)

