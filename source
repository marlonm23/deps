-- ==========================================
-- FUNÇÕES DE SUPORTE E LÓGICA DE JOGO
-- ==========================================

local function getTargetPlayer()
    if attackAllActive then return nil end
    local query = targetBox.Text:lower()
    if query == "" then return nil end
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local pName = player.Name:lower()
            local pDisp = player.DisplayName:lower()
            if pName:sub(1, #query) == query or pDisp:sub(1, #query) == query or pName:find(query) or pDisp:find(query) then
                return player
            end
        end
    end
    return nil
end

local function isValidTarget(targetChar)
    if not targetChar then return false end
    local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
    local humanoid = targetChar:FindFirstChildOfClass("Humanoid")
    if not targetRoot or not humanoid or humanoid.Health <= 0 then 
        return false 
    end
    return true
end

-- ==========================================
-- LOOP 1: ANTI-FLING E BUFFS / DEBUFFS MONITOR
-- ==========================================
RunService.Heartbeat:Connect(function()
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    
    -- Lógica do Anti-Fling
    if antiFlingActive and rootPart then
        if rootPart.AssemblyLinearVelocity.Magnitude > 300 or rootPart.AssemblyAngularVelocity.Magnitude > 300 then
            rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
        end
    end
    
    -- Lógica dos Buffs Customizados (Aba 2)
    if humanoid then
        if buffsActive then
            humanoid.WalkSpeed = 24 -- Buff de Velocidade
            humanoid.JumpPower = 60 -- Buff de Pulo
            statusLabel.Text = "\n [ STATUS ATUAL ]\n\n• Velocidade: 24 (BUFF)\n• Pulo: 60 (BUFF)\n• Estado: Ativo\n• Anti-Fling: " .. (antiFlingActive and "Ativo" else "Inativo")
        else
            humanoid.WalkSpeed = 16 -- Padrão
            humanoid.JumpPower = 50 -- Padrão
            statusLabel.Text = "\n [ STATUS ATUAL ]\n\n• Velocidade: Normal (16)\n• Pulo: Normal (50)\n• Estado: Sem Buffs\n• Anti-Fling: " .. (antiFlingActive and "Ativo" else "Inativo")
        end
    end
end)

-- ==========================================
-- LOOP 2: FLY (VOAR)
-- ==========================================
task.spawn(function()
    local bodyVel, bodyGyro
    while true do
        local character = LocalPlayer.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        
        if flyActive and rootPart then
            if not rootPart:FindFirstChild("FlyVelocity") then
                bodyVel = Instance.new("BodyVelocity")
                bodyVel.Name = "FlyVelocity"
                bodyVel.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bodyVel.Velocity = Vector3.new(0, 0, 0)
                bodyVel.Parent = rootPart
                
                bodyGyro = Instance.new("BodyGyro")
                bodyGyro.Name = "FlyGyro"
                bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
                bodyGyro.CFrame = rootPart.CFrame
                bodyGyro.Parent = rootPart
            end
            
            local camera = Workspace.CurrentCamera
            local moveDir = Vector3.new(0, 0, 0)
            
            -- Controles básicos de voo
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                moveDir = moveDir + camera.CFrame.LookVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                moveDir = moveDir - camera.CFrame.LookVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                moveDir = moveDir - camera.CFrame.RightVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                moveDir = moveDir + camera.CFrame.RightVector
            end
            
            bodyVel.Velocity = moveDir * 50
            bodyGyro.CFrame = camera.CFrame
        else
            if rootPart then
                local bv = rootPart:FindFirstChild("FlyVelocity")
                local bg = rootPart:FindFirstChild("FlyGyro")
                if bv then bv:Destroy() end
                if bg then bg:Destroy() end
            end
        end
        task.wait()
    end
end)

-- ==========================================
-- LOOP 3: MANIPULAÇÃO DE PEÇAS (MAPA)
-- ==========================================
task.spawn(function()
    while true do
        if not partsActive then
            task.wait(0.5)
            continue
        end

        local character = LocalPlayer.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")

        if rootPart then
            for _, item in ipairs(Workspace:GetDescendants()) do
                if not partsActive then break end
                if item:IsA("BasePart") and not item.Anchored and not item:IsDescendantOf(character) then
                    if item.Size.Magnitude < 30 then
                        pcall(function()
                            item.CFrame = rootPart.CFrame + Vector3.new(math.random(-5, 5), 5, math.random(-5, 5))
                            item.AssemblyLinearVelocity = Vector3.new(0, -20, 0)
                        end)
                    end
                end
            end
        end
        task.wait(1)
    end
end)

-- ==========================================
-- LOOP 4: MASS WALKFLING (ATACAR TODOS OU ALVO)
-- ==========================================
task.spawn(function()
    while true do
        if not flingActive then
            task.wait(0.2)
            continue
        end

        local character = LocalPlayer.Character
        local rootPart = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        
        if not rootPart or not humanoid or humanoid.Health <= 0 then
            task.wait(0.5)
            continue
        end

        local targets = {}
        
        if attackAllActive then
            -- Ataca todos os jogadores válidos no servidor
            for _, player in ipairs(Players:GetPlayers()) do
                if player ~= LocalPlayer and player.Character and isValidTarget(player.Character) then
                    table.insert(targets, player)
                end
            end
        else
            -- Ataca apenas o alvo específico buscado pela caixa de texto
            local targetPlayer = getTargetPlayer()
            if targetPlayer and targetPlayer.Character and isValidTarget(targetPlayer.Character) then
                table.insert(targets, targetPlayer)
            end
        end

        if #targets > 0 then
            for _, targetPlayer in ipairs(targets) do
                if not flingActive then break end
                
                local startTime = tick()
                while flingActive and isValidTarget(targetPlayer.Character) do
                    character = LocalPlayer.Character
                    rootPart = character and character:FindFirstChild("HumanoidRootPart")
                    
                    if not character or not rootPart then break end
                    
                    local targetChar = targetPlayer.Character
                    local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
                    
                    if targetRoot then
                        pcall(function()
                            targetRoot.CanCollide = true
                            for _, part in ipairs(targetChar:GetChildren()) do
                                if part:IsA("BasePart") then part.CanCollide = true end
                            end
                        end)
                        
                        local randomOffset = CFrame.new(
                            math.random(-150, 150) / 100, 
                            math.random(-50, 100) / 100, 
                            math.random(-150, 150) / 100
                        )
                        rootPart.CFrame = targetRoot.CFrame * randomOffset
                        rootPart.AssemblyLinearVelocity = Vector3.new(50000, 50000, 50000)
                        rootPart.AssemblyAngularVelocity = Vector3.new(50000, 50000, 50000)
                    else
                        break
                    end
                    
                    RunService.Heartbeat:Wait()
                    if tick() - startTime > 0.3 then break end -- Alterna entre alvos se for "Atacar Todos"
                end
            end
        else
            task.wait(0.5)
        end
    end
end)