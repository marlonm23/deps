-- Função de Rastreio com Avatar Matcher (Bypass de Perfil Fechado por Comparação de Miniaturas)
local function trackAndTeleport(userId, btnLabel)
    if btnLabel.Text:find("Buscando") then return end

    local originalText = "Localizar"
    btnLabel.Text = "🔄 Varrendo Avatares..."
    btnLabel.BackgroundColor3 = Color3.fromRGB(180, 120, 40)

    task.defer(function()
        local inCurrentServer = Players:GetPlayerByUserId(userId)
        if inCurrentServer then
            btnLabel.Text = "✨ Já está aqui!"
            btnLabel.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
            task.wait(1.5)
            btnLabel.Text = originalText
            btnLabel.BackgroundColor3 = Color3.fromRGB(45, 120, 220)
            return
        end

        local reqFunc = (syn and syn.request) or (http and http.request) or request or http_request
        if not reqFunc then
            btnLabel.Text = "❌ Sem HTTP"
            task.wait(2)
            btnLabel.Text = originalText
            btnLabel.BackgroundColor3 = Color3.fromRGB(45, 120, 220)
            return
        end

        -- 1. Pega a URL do headshot do avatar do alvo
        local headshotUrl = string.format("https://thumbnails.roproxy.com/v1/users/avatar-headshot?userIds=%d&size=150x150&format=Png&isCircular=false", userId)
        local headshotRes = pcall(function() return reqFunc({ Url = headshotUrl, Method = "GET" }) end)
        
        if not headshotRes then
            btnLabel.Text = "⚠️ Erro na API"
            task.wait(2)
            btnLabel.Text = originalText
            btnLabel.BackgroundColor3 = Color3.fromRGB(45, 120, 220)
            return
        end

        local headshotData = HttpService:JSONDecode(headshotRes)
        if not headshotData.data or #headshotData.data == 0 then
            btnLabel.Text = "⚠️ Alvo sem Avatar"
            task.wait(2)
            btnLabel.Text = originalText
            btnLabel.BackgroundColor3 = Color3.fromRGB(45, 120, 220)
            return
        end

        local targetImageUrl = headshotData.data[1].imageUrl

        -- 2. Varre os servidores públicos em busca do match da imagem do avatar
        local cursor = ""
        local foundJobId = nil

        for page = 1, 8 do
            local serverApiUrl = string.format("https://games.roproxy.com/v1/games/%d/servers/Public?sortOrder=Desc&limit=100%s", game.PlaceId, cursor ~= "" and "&cursor="..cursor or "")
            local serverRes = pcall(function() return reqFunc({ Url = serverApiUrl, Method = "GET" }) end)
            
            if serverRes then
                local serverData = HttpService:JSONDecode(serverRes)
                if serverData and serverData.data then
                    for _, server in ipairs(serverData.data) do
                        if server.playerTokens and #server.playerTokens > 0 then
                            local tokenList = {}
                            for _, token in ipairs(server.playerTokens) do
                                table.insert(tokenList, { token = token, type = "AvatarHeadshot", size = "150x150" })
                            end
                            
                            local batchRes = pcall(function()
                                return reqFunc({
                                    Url = "https://thumbnails.roproxy.com/v1/batch",
                                    Method = "POST",
                                    Headers = { ["Content-Type"] = "application/json" },
                                    Body = HttpService:JSONEncode(tokenList)
                                })
                            end)

                            if batchRes then
                                local batchData = HttpService:JSONDecode(batchRes)
                                if batchData and batchData.data then
                                    for _, item in ipairs(batchData.data) do
                                        if item.imageUrl == targetImageUrl then
                                            foundJobId = server.id
                                            break
                                        end
                                    end
                                end
                            end
                        end
                        if foundJobId then break end
                    end

                    if foundJobId or not serverData.nextPageCursor then break end
                    cursor = serverData.nextPageCursor
                else
                    break
                end
            else
                break
            end
            task.wait(0.2)
        end

        if foundJobId then
            btnLabel.Text = "🚀 Entrando..."
            btnLabel.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
            saveStateAndTeleport(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, foundJobId, LocalPlayer)
            end)
            return
        end

        btnLabel.Text = "⚠️ Não Encontrado"
        btnLabel.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
        task.wait(2.5)
        btnLabel.Text = originalText
        btnLabel.BackgroundColor3 = Color3.fromRGB(45, 120, 220)
    end)
end

-- Carrega o JSON em background total
local enemiesList = {}

local function loadEnemiesJSON()
    task.defer(function()
        local success, rawData = pcall(function()
            return game:HttpGet(jsonUrl)
        end)

        if not success or not rawData then
            statusCsvLabel.Text = "❌ Erro ao baixar JSON!"
            statusCsvLabel.TextColor3 = Color3.fromRGB(220, 100, 100)
            enemiesScroll.CanvasSize = UDim2.new(0, 0, 0, 30)
            return
        end

        local decodeSuccess, decodedData = pcall(function()
            return HttpService:JSONDecode(rawData)
        end)

        if not decodeSuccess or not decodedData then
            statusCsvLabel.Text = "❌ Erro ao decodificar JSON!"
            statusCsvLabel.TextColor3 = Color3.fromRGB(220, 100, 100)
            enemiesScroll.CanvasSize = UDim2.new(0, 0, 0, 30)
            return
        end

        statusCsvLabel:Destroy()

        for _, entry in ipairs(decodedData) do
            if entry.name and entry.id then
                table.insert(enemiesList, { name = tostring(entry.name), id = tonumber(entry.id) })
            end
        end

        if #enemiesList == 0 then
            local emptyLbl = Instance.new("TextLabel")
            emptyLbl.Size = UDim2.new(1, 0, 0, 30)
            emptyLbl.BackgroundTransparency = 1
            emptyLbl.TextColor3 = Color3.fromRGB(220, 180, 100)
            emptyLbl.TextSize = 11
            emptyLbl.Font = Enum.Font.SourceSans
            emptyLbl.Text = "Nenhum inimigo encontrado!"
            emptyLbl.Parent = enemiesScroll
            return
        end

        for _, enemy in ipairs(enemiesList) do
            local row = Instance.new("Frame")
            row.Name = enemy.name
            row.Size = UDim2.new(1, 0, 0, 26)
            row.BackgroundTransparency = 1
            row.Parent = enemiesScroll

            local nameLbl = Instance.new("TextLabel")
            nameLbl.Size = UDim2.new(0.6, 0, 1, 0)
            nameLbl.BackgroundTransparency = 1
            nameLbl.TextColor3 = Color3.fromRGB(230, 230, 240)
            nameLbl.TextSize = 11
            nameLbl.Font = Enum.Font.SourceSansBold
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            nameLbl.Text = " " .. enemy.name
            nameLbl.Parent = row

            local locBtn = Instance.new("TextButton")
            locBtn.Size = UDim2.new(0.4, 0, 1, 0)
            locBtn.Position = UDim2.new(0.6, 0, 0, 0)
            locBtn.BackgroundColor3 = Color3.fromRGB(45, 120, 220)
            locBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            locBtn.TextSize = 11
            locBtn.Font = Enum.Font.SourceSansBold
            locBtn.Text = "Localizar"
            locBtn.Parent = row
            Instance.new("UICorner", locBtn).CornerRadius = UDim.new(0, 5)

            locBtn.MouseButton1Click:Connect(function()
                trackAndTeleport(enemy.id, locBtn)
            end)
        end

        enemiesScroll.CanvasSize = UDim2.new(0, 0, 0, #enemiesList * 30)
    end)
end

