-- Loop de Arremesso dos Blocos Pretos da Lava
task.spawn(function()
    while true do
        if not throwPartsActive then
            task.wait(0.2)
            continue
        end

        local targetChar = nil
        if todosActive then
            local validPlayers = {}
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and isValidTarget(p.Character) then
                    table.insert(validPlayers, p.Character)
                end
            end
            if #validPlayers > 0 then
                targetChar = validPlayers[math.random(1, #validPlayers)]
            end
        else
            local targetPlayer = getTargetPlayer()
            if targetPlayer and targetPlayer.Character and isValidTarget(targetPlayer.Character) then
                targetChar = targetPlayer.Character
            end
        end

        if targetChar and targetChar:FindFirstChild("HumanoidRootPart") then
            local targetRoot = targetChar.HumanoidRootPart
            
            for _, part in ipairs(Workspace:GetDescendants()) do
                if not throwPartsActive then break end
                
                if part:IsA("BasePart") and not part.Anchored then
                    local color = part.Color
                    local isBlack = color.R < 0.15 and color.G < 0.15 and color.B < 0.15
                    
                    if isBlack then
                        local isCharacterPart = false
                        for _, p in ipairs(Players:GetPlayers()) do
                            if p.Character and part:IsDescendantOf(p.Character) then
                                isCharacterPart = true
                                break
                            end
                        end

                        if not isCharacterPart then
