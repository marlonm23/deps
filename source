-- Função de Identificação de Alvos
local function getFilteredPlayers()
    local list = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if Config.TargetAll then
                table.insert(list, p)
            else
                if Config.TargetQuery ~= "" and (string.find(p.Name:lower(), Config.TargetQuery) or string.find(p.DisplayName:lower(), Config.TargetQuery)) then
                    table.insert(list, p)
                end
            end
        end
    end
    return list
end

